server {
    listen 80;
    server_name {{ vhost.subdomain }};

    location / {
        proxy_pass         http://127.0.0.1:{{ vhost.port }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout {{ vhost.timeout | default(60) }}s;
        proxy_buffering    off;
    }
{% if vhost.extra_locations is defined %}
{% for loc in vhost.extra_locations %}

    location {{ loc.path }} {
        proxy_pass         http://127.0.0.1:{{ loc.port }}{{ loc.path }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout {{ loc.timeout | default(60) }}s;
    }
{% endfor %}
{% endif %}
}
